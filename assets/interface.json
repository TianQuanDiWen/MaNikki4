{
    "interface_version": 2,
    "name": "MaNikki4",
    "description": "基于 MaaFramework 的闪耀暖暖游戏自动化项目。",
    "contact": "",
    "license": "MIT",
    "welcome": "欢迎使用 MaNikki4。",
    "version": "0.1.0",
    "agent": {
        "child_exec": "go",
        "child_args": [
            "run",
            "../agent/cmd/manikki-agent",
            "agent",
            "--root",
            ".."
        ]
    },
    "pretask": {
        "name": "启动模拟器与游戏",
        "exec": "go",
        "args": [
            "run",
            "../agent/cmd/manikki-agent",
            "pretask",
            "--root",
            ".."
        ],
        "option": [
            "MuMuConfig"
        ]
    },
    "controller": [
        {
            "name": "MuMu模拟器",
            "description": "通过 ADB 连接并操作 MuMu 模拟器",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "__MXU_PRETASK__启动模拟器与游戏",
            "label": "启动模拟器与游戏",
            "entry": "登陆游戏",
            "option": [
                "MuMuConfig"
            ],
            "description": "启动 MuMu 模拟器并拉起闪耀暖暖应用",
            "default_check": true
        },
        {
            "name": "登陆游戏",
            "entry": "登陆游戏",
            "description": "启动闪耀暖暖并进入游戏",
            "default_check": true
        },
        {
            "name": "闪暖送礼",
            "entry": "送礼_开始",
            "description": "完成好友送心、领取体力与日常采购",
            "default_check": true
        },
        {
            "name": "闪暖组队本",
            "entry": "结伴_开始",
            "description": "完成不落的帷幕、印象航旅与时光钟表铺",
            "default_check": true
        },
        {
            "name": "闪暖竞技场",
            "entry": "竞技场_开始",
            "description": "完成钻石竞技场任务",
            "default_check": true
        },
        {
            "name": "闪暖抽卡",
            "entry": "抽卡_开始",
            "description": "领取心之门免费抽取与分享奖励",
            "default_check": true
        },
        {
            "name": "联盟任务",
            "entry": "联盟_开始",
            "description": "完成联盟捐献、机密任务与联盟福利",
            "default_check": true
        },
        {
            "name": "忆海心阶",
            "entry": "忆海_开始",
            "description": "完成忆海心阶挑战",
            "default_check": true
        },
        {
            "name": "美甲",
            "entry": "美甲_开始",
            "description": "完成美甲店铺店员雇佣与收益提取",
            "default_check": true
        },
        {
            "name": "分享",
            "entry": "分享_开始",
            "description": "分享到外部APP拿分享粉钻",
            "option": [
                "ShareAppOption"
            ],
            "default_check": true
        },
        {
            "name": "时空回廊制衣",
            "entry": "制衣_开始",
            "description": "挑战时空回廊，请将时空回廊套装配置到制衣引导第一套",
            "pipeline_override": {
                "制衣_分发目标": {
                    "next": [
                        "制衣_选择第1套全部材料"
                    ]
                }
            },
            "option": [
                "ShikongMainStageOption",
                "StoreOption"
            ],
            "default_check": true
        },
        {
            "name": "主线制衣",
            "entry": "制衣_开始",
            "description": "挑战普通主线材料关卡，请将需要制作的套装配置到制衣引导第二套",
            "pipeline_override": {
                "制衣_分发目标": {
                    "next": [
                        "制衣_选择第2套全部材料"
                    ]
                }
            },
            "option": [
                "StoreOption"
            ],
            "default_check": true
        },
        {
            "name": "任务",
            "entry": "任务_开始",
            "description": "领取每日任务奖励",
            "default_check": true
        },
        {
            "name": "退出模拟器",
            "entry": "退出模拟器",
            "description": "全部日常任务执行完毕后，安全退出 MuMu 模拟器",
            "default_check": false
        }
    ],
    "option": {
        "MuMuConfig": {
            "type": "input",
            "label": "MuMu模拟器路径",
            "description": "MuMu 模拟器主程序路径。留空会自动检测；首次选定后会自动保存回显在此处",
            "inputs": [
                {
                    "name": "mumu_path",
                    "label": "模拟器路径",
                    "default": ""
                }
            ]
        },
        "ShikongMainStageOption": {
            "type": "switch",
            "label": "时空回廊挑战主线关卡",
            "description": "开启时若时空回廊套装包含普通主线材料，在打完时空回廊后前往挑战；关闭时仅刷时空回廊专属关卡",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启"
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "制衣_材料_主线": {
                            "enabled": false,
                            "recognition": {
                                "type": "Custom",
                                "param": {
                                    "custom_recognition": "MatchRowButton",
                                    "custom_recognition_param": {
                                        "keyword": "__DISABLED__",
                                        "button": "前往"
                                    }
                                }
                            }
                        },
                        "制衣_关卡_次数不足取消": {
                            "next": [
                                "制衣_时空回廊直接结束"
                            ]
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "StoreOption": {
            "type": "switch",
            "label": "自动购买商店材料",
            "description": "开启后若遇到需要购买服装店材料，自动前往并购买",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启"
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "制衣_材料_商店": {
                            "recognition": {
                                "type": "Custom",
                                "param": {
                                    "custom_recognition": "MatchRowButton",
                                    "custom_recognition_param": {
                                        "keyword": "__DISABLED__",
                                        "button": "前往"
                                    }
                                }
                            }
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "ShareAppOption": {
            "type": "select",
            "label": "分享目标APP",
            "description": "每日分享拿粉钻时调起的社交平台，需要自行在模拟器上安装对应app",
            "cases": [
                {
                    "name": "QQ",
                    "label": "QQ",
                    "pipeline_override": {
                        "分享_点击分享": {
                            "next": [
                                "抽阁_分享QQ"
                            ]
                        }
                    }
                },
                {
                    "name": "WeChat",
                    "label": "微信",
                    "pipeline_override": {
                        "分享_点击分享": {
                            "next": [
                                "抽阁_分享微信"
                            ]
                        }
                    }
                },
                {
                    "name": "Weibo",
                    "label": "微博",
                    "pipeline_override": {
                        "分享_点击分享": {
                            "next": [
                                "抽阁_分享微博"
                            ]
                        }
                    }
                },
                {
                    "name": "Xiaohongshu",
                    "label": "小红书",
                    "pipeline_override": {
                        "分享_点击分享": {
                            "next": [
                                "抽阁_分享小红书"
                            ]
                        }
                    }
                }
            ],
            "default_case": "QQ"
        }
    },
    "preset": [
        {
            "name": "默认配置",
            "label": "默认配置",
            "description": "自动勾选已就绪的日常任务（启动模拟器与游戏、送礼、组队本、抽卡、联盟任务、忆海心阶、美甲）",
            "task": [
                {
                    "name": "__MXU_PRETASK__启动模拟器与游戏",
                    "enabled": true
                },
                {
                    "name": "登陆游戏",
                    "enabled": true
                },
                {
                    "name": "闪暖送礼",
                    "enabled": true
                },
                {
                    "name": "闪暖组队本",
                    "enabled": true
                },
                {
                    "name": "闪暖竞技场",
                    "enabled": true
                },
                {
                    "name": "闪暖抽卡",
                    "enabled": true
                },
                {
                    "name": "联盟任务",
                    "enabled": true
                },
                {
                    "name": "忆海心阶",
                    "enabled": true
                },
                {
                    "name": "美甲",
                    "enabled": true
                },
                {
                    "name": "分享",
                    "enabled": true
                },
                {
                    "name": "时空回廊制衣",
                    "enabled": true
                },
                {
                    "name": "主线制衣",
                    "enabled": true
                },
                
                {
                    "name": "任务",
                    "enabled": true
                },
                {
                    "name": "退出模拟器",
                    "enabled": false
                }
            ]
        }
    ]
}
