{
    "interface_version": 2,
    "name": "MaNikki4",
    "description": "基于 MaaFramework 的闪耀暖暖游戏自动化项目。",
    "contact": "",
    "license": "MIT",
    "welcome": "欢迎使用 MaNikki4。",
    "version": "0.1.0",
    "agent": {
        "child_exec": "go",
        "child_args": [
            "run",
            "../agent/cmd/manikki-agent",
            "agent",
            "--root",
            ".."
        ]
    },
    "pretask": {
        "name": "启动模拟器与游戏",
        "exec": "go",
        "args": [
            "run",
            "../agent/cmd/manikki-agent",
            "pretask",
            "--root",
            ".."
        ],
        "option": [
            "MuMuConfig"
        ]
    },
    "controller": [
        {
            "name": "MuMu模拟器",
            "description": "通过 ADB 连接并操作 MuMu 模拟器",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "__MXU_PRETASK__启动模拟器与游戏",
            "label": "启动模拟器与游戏",
            "entry": "登陆游戏",
            "option": [
                "MuMuConfig"
            ],
            "description": "启动 MuMu 模拟器并拉起闪耀暖暖应用",
            "default_check": true
        },
        {
            "name": "登陆游戏",
            "entry": "登陆游戏",
            "description": "启动闪耀暖暖并进入游戏",
            "default_check": true
        },
        {
            "name": "闪暖送礼",
            "entry": "送礼_开始",
            "description": "完成好友送心、领取体力与日常采购",
            "default_check": true
        },
        {
            "name": "闪暖组队本",
            "entry": "结伴_开始",
            "description": "完成不落的帷幕、印象航旅与时光钟表铺",
            "default_check": true
        },
        {
            "name": "闪暖竞技场",
            "entry": "竞技场_开始",
            "description": "完成钻石竞技场任务",
            "default_check": true
        },
        {
            "name": "闪暖抽卡",
            "entry": "抽卡_开始",
            "description": "领取心之门免费抽取与分享奖励",
            "default_check": true
        },
        {
            "name": "联盟任务",
            "entry": "联盟_开始",
            "description": "完成联盟捐献、机密任务与联盟福利",
            "default_check": true
        },
        {
            "name": "忆海心阶",
            "entry": "忆海_开始",
            "description": "完成忆海心阶挑战",
            "default_check": true
        },
        {
            "name": "美甲",
            "entry": "美甲_开始",
            "description": "完成美甲店铺店员雇佣与收益提取",
            "default_check": true
        },
        {
            "name": "分享",
            "entry": "分享_开始",
            "description": "分享到外部APP拿分享粉钻",
            "default_check": false
        },
        {
            "name": "任务",
            "entry": "任务_开始",
            "description": "领取每日任务奖励",
            "default_check": true
        },
        {
            "name": "退出模拟器",
            "entry": "退出模拟器",
            "description": "全部日常任务执行完毕后，安全退出 MuMu 模拟器",
            "default_check": false
        }
    ],
    "option": {
        "MuMuConfig": {
            "type": "input",
            "label": "MuMu模拟器路径",
            "description": "MuMu 模拟器主程序路径。留空会自动检测；首次选定后会自动保存回显在此处",
            "inputs": [
                {
                    "name": "mumu_path",
                    "label": "模拟器路径",
                    "default": ""
                }
            ]
        }
    },
    "preset": [
        {
            "name": "默认配置",
            "label": "默认配置",
            "description": "自动勾选已就绪的日常任务（启动模拟器与游戏、送礼、组队本、抽卡、联盟任务、忆海心阶、美甲）",
            "task": [
                {
                    "name": "__MXU_PRETASK__启动模拟器与游戏",
                    "enabled": true
                },
                {
                    "name": "登陆游戏",
                    "enabled": true
                },
                {
                    "name": "闪暖送礼",
                    "enabled": true
                },
                {
                    "name": "闪暖组队本",
                    "enabled": true
                },
                {
                    "name": "闪暖竞技场",
                    "enabled": true
                },
                {
                    "name": "闪暖抽卡",
                    "enabled": true
                },
                {
                    "name": "联盟任务",
                    "enabled": true
                },
                {
                    "name": "忆海心阶",
                    "enabled": true
                },
                {
                    "name": "美甲",
                    "enabled": true
                },
                {
                    "name": "分享",
                    "enabled": false
                },
                {
                    "name": "任务",
                    "enabled": true
                },
                {
                    "name": "退出模拟器",
                    "enabled": false
                }
            ]
        }
    ]
}
