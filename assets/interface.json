{
    "interface_version": 2,
    "name": "MaNikki4",
    "icon": "assets/icon.png",
    "logo": "assets/logo.png",
    "theme_color": "#FF7EA7",
    "accent_color": "暖暖粉",
    "description": "**✨ 《闪耀暖暖》自动化日常助手 · 基于 MaaFramework ✨**\n\n[🌸 前往 GitHub 仓库](https://github.com/TianQuanDiWen/MaNikki4) ｜ [💡 问题与建议反馈](https://github.com/TianQuanDiWen/MaNikki4/issues)\n\n_如果觉得好用，欢迎在 GitHub 点亮一颗小星星 🌟 鼓励作者！_\n\n---\n🛡️ 本软件永久免费开源（AGPL-3.0），严禁用于倒卖牟利或收费代练。", 
    "contact": "[前往 GitHub Issues 提交反馈](https://github.com/TianQuanDiWen/MaNikki4/issues)",
    "license": "AGPL-3.0",
    "welcome": "### 🌸 欢迎使用 MaNikki4！\n基于 **MaaFramework** 开发的《闪耀暖暖》全自动日常助手，助你轻松解放双手。\n\n> **📢 免费与开源声明**  \n> 本项目遵循 AGPL-3.0 协议**完全免费开源**，严禁任何形式的倒卖、转售或收费代练。若您通过付费途径购得，请立即维权退款并举报商家！\n\n> **⚠️ 使用提示与免责**  \n> 软件基于图像识别与模拟操作，仅供个人学习研究与日常减负使用，使用风险由使用者自行评估承担。\n\n---\n⭐ **开源不易**：如果 MaNikki4 帮您节省了日常时间，欢迎前往 [GitHub 仓库](https://github.com/TianQuanDiWen/MaNikki4) 点亮一颗 Star 给予支持！使用遇到异常请在 [Issues 反馈区](https://github.com/TianQuanDiWen/MaNikki4/issues) 附带 `debug/` 日志提交。",
    "github": "https://github.com/TianQuanDiWen/MaNikki4",
    "version": "0.1.0",
    "agent": {
        "identifier": "pi-agent-1",
        "child_exec": "go",
        "child_args": [
            "run",
            "../agent/cmd/manikki-agent",
            "agent",
            "--root",
            ".."
        ]
    },
    "pretask": {
        "name": "启动模拟器与游戏",
        "exec": "go",
        "args": [
            "run",
            "../agent/cmd/manikki-agent",
            "pretask",
            "--root",
            ".."
        ],
        "option": [
            "MuMuConfig"
        ]
    },
    "controller": [
        {
            "name": "MuMu模拟器",
            "description": "通过 ADB 连接并操作 MuMu 模拟器",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        },
        {
            "name": "台服",
            "path": [
                "./resource"
            ],
            "option": [
                "ServerOption_TW"
            ]
        }
    ],
    "task": [
        {
            "name": "__MXU_PRETASK__启动模拟器与游戏",
            "label": "🎮 启动模拟器与游戏",
            "entry": "登陆游戏",
            "option": [
                "MuMuConfig"
            ],
            "description": "启动 MuMu 模拟器并拉起闪耀暖暖应用",
            "default_check": true
        },
        {
            "name": "登陆游戏",
            "label": "🚀 登陆游戏",
            "entry": "登陆游戏",
            "description": "启动闪耀暖暖并进入游戏",
            "default_check": true
        },
        {
            "name": "送礼",
            "label": "💌 送礼",
            "entry": "送礼_开始",
            "description": "完成好友送心、领取体力与日常采购",
            "default_check": true
        },
        {
            "name": "组队本",
            "label": "👥 组队本",
            "entry": "结伴_开始",
            "description": "完成不落的帷幕、印象航旅与时光钟表铺",
            "default_check": true
        },
        {
            "name": "竞技场",
            "label": "⚔️ 竞技场",
            "entry": "竞技场_开始",
            "description": "完成钻石竞技场任务",
            "default_check": true
        },
        {
            "name": "抽卡",
            "label": "🚪 抽卡",
            "entry": "抽卡_开始",
            "description": "领取心之门免费抽取与分享奖励",
            "default_check": true
        },
        {
            "name": "联盟任务",
            "label": "🏛️ 联盟任务",
            "entry": "联盟_开始",
            "description": "完成联盟捐献、机密任务与联盟福利",
            "option": [
                "AllianceDonateOption"
            ],
            "default_check": true
        },
        {
            "name": "忆海心阶",
            "label": "🌊 忆海心阶",
            "entry": "忆海_开始",
            "description": "完成忆海心阶挑战",
            "option": [
                "YihaiJingyuOption"
            ],
            "default_check": true
        },
        {
            "name": "美甲",
            "label": "💅 美甲店铺",
            "entry": "美甲_开始",
            "description": "完成美甲店铺店员雇佣与收益提取",
            "default_check": true
        },
        {
            "name": "分享",
            "label": "💎 分享",
            "entry": "分享_开始",
            "description": "分享到外部APP拿分享粉钻",
            "option": [
                "ShareAppOption"
            ],
            "default_check": true
        },
        {
            "name": "评选赛",
            "label": "🏆 搭配评选赛",
            "entry": "评选赛_开始",
            "option": [
                "ContestAutoSubmitOption"
            ],
            "description": "进入搭配评选赛，自动当评委点赞投票与自动投稿参赛",
            "default_check": true
        },
        {
            "name": "时空回廊",
            "label": "👗 时空回廊",
            "entry": "制衣_开始",
            "description": "挑战时空回廊，请将时空回廊套装配置到制衣引导第一套",
            "pipeline_override": {
                "制衣_分发目标": {
                    "next": [
                        "制衣_第1套"
                    ]
                }
            },
            "option": [
                "ShikongMainStageOption",
                "StoreOption"
            ],
            "default_check": true
        },
        {
            "name": "主线制衣",
            "label": "🧵 主线制衣",
            "entry": "制衣_开始",
            "description": "挑战普通主线材料关卡，请将需要制作的套装配置到制衣引导第二套",
            "pipeline_override": {
                "制衣_分发目标": {
                    "next": [
                        "制衣_第2套"
                    ]
                }
            },
            "option": [
                "StoreOption"
            ],
            "default_check": true
        },
        {
            "name": "任务",
            "label": "📋 任务奖励",
            "entry": "任务_开始",
            "description": "领取每日任务奖励",
            "option": [
                "TaskPrivilegeOption",
                "FashionTaskOption"
            ],
            "default_check": true
        },
        {
            "name": "退出模拟器",
            "label": "🛑 退出模拟器",
            "entry": "退出模拟器",
            "option": [
                "CloseLauncherOption"
            ],
            "description": "全部日常任务执行完毕后，安全退出 MuMu 模拟器",
            "default_check": false
        }
    ],
    "option": {
        "AllianceDonateOption": {
            "type": "select",
            "label": "粉钻捐献档位",
            "description": "完成免费与金币捐献后，额外的每日首次粉钻捐献档位；默认不捐",
            "cases": [
                {
                    "name": "None",
                    "label": "不捐粉钻 (默认)",
                    "pipeline_override": {
                        "联盟_捐献": {
                            "next": [
                                "[JumpBack]联盟_免费捐献",
                                "联盟_退出捐献"
                            ]
                        }
                    }
                },
                {
                    "name": "Donate10",
                    "label": "捐 10 粉钻",
                    "pipeline_override": {
                        "联盟_捐献": {
                            "next": [
                                "[JumpBack]联盟_免费捐献",
                                "[JumpBack]联盟_捐10粉钻",
                                "联盟_退出捐献"
                            ]
                        }
                    }
                },
                {
                    "name": "Donate50",
                    "label": "捐 50 粉钻",
                    "pipeline_override": {
                        "联盟_捐献": {
                            "next": [
                                "[JumpBack]联盟_免费捐献",
                                "[JumpBack]联盟_捐50粉钻",
                                "联盟_退出捐献"
                            ]
                        }
                    }
                },
                {
                    "name": "DonateAll",
                    "label": "捐献 10+50 粉钻",
                    "pipeline_override": {
                        "联盟_捐献": {
                            "next": [
                                "[JumpBack]联盟_免费捐献",
                                "[JumpBack]联盟_捐10粉钻",
                                "[JumpBack]联盟_捐50粉钻",
                                "联盟_退出捐献"
                            ]
                        }
                    }
                }
            ],
            "default_case": "None"
        },
        "ContestAutoSubmitOption": {
            "type": "switch",
            "label": "自动投稿参赛",
            "description": "开启后若本周评选赛尚未投稿，自动随机穿戴已集齐套装并完成投稿参赛；关闭时仅执行每日点赞投票",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "评选赛_中继": {
                            "next": [
                                "评选赛_次数不足",
                                "评选赛_进入评选",
                                "评选赛_进入参赛",
                                "评选赛_已投稿"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "评选赛_中继": {
                            "next": [
                                "评选赛_次数不足",
                                "评选赛_进入评选",
                                "评选赛_未选参赛",
                                "评选赛_已投稿"
                            ]
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "CloseLauncherOption": {
            "type": "switch",
            "label": "同时关闭启动器主面板",
            "description": "开启后在模拟器退出完毕后直接关闭 MuMu 启动器主面板，彻底清除后台残留；关闭时仅退出模拟器虚拟机并保留启动器",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "退出模拟器": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "close_launcher": true
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "退出模拟器": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "close_launcher": false
                                    }
                                }
                            }
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "MuMuConfig": {
            "type": "input",
            "label": "MuMu模拟器路径",
            "description": "MuMu 模拟器主程序路径。留空会自动检测；首次选定后会自动保存回显在此处",
            "inputs": [
                {
                    "name": "mumu_path",
                    "label": "模拟器路径",
                    "default": ""
                }
            ]
        },
        "ShikongMainStageOption": {
            "type": "switch",
            "label": "时空回廊挑战主线关卡",
            "description": "开启时若时空回廊套装包含普通主线材料，在打完时空回廊后前往挑战；关闭时仅刷时空回廊专属关卡",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启"
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "制衣_材料_主线": {
                            "enabled": false,
                            "recognition": {
                                "type": "Custom",
                                "param": {
                                    "custom_recognition": "MatchRowButton",
                                    "custom_recognition_param": {
                                        "keyword": "__DISABLED__",
                                        "button": "前往"
                                    }
                                }
                            }
                        },
                        "制衣_关卡_次数不足取消": {
                            "next": [
                                "制衣_时空回廊直接结束"
                            ]
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "StoreOption": {
            "type": "switch",
            "label": "自动购买商店材料",
            "description": "开启后若遇到需要购买服装店材料，自动前往并购买",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启"
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "制衣_材料_商店": {
                            "recognition": {
                                "type": "Custom",
                                "param": {
                                    "custom_recognition": "MatchRowButton",
                                    "custom_recognition_param": {
                                        "keyword": "__DISABLED__",
                                        "button": "前往"
                                    }
                                }
                            }
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "ServerOption_TW": {
            "type": "switch",
            "label": "台服客户端拉回",
            "description": "台服环境下自动使用 shell 兼容拉回（同时支持官网版与 Google Play 版）",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "分享_强制拉回游戏": {
                            "action": {
                                "type": "Shell",
                                "param": {
                                    "cmd": "am start -n com.shining.nikki4.tw/com.nikki.nn4lib.NN4PlayerActivity || am start -n com.papegames.nn4.tw/com.nikki.nn4lib.NN4PlayerActivity"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭"
                }
            ],
            "default_case": "Yes"
        },
        "ShareAppOption": {
            "type": "select",
            "label": "分享目标APP",
            "description": "每日分享拿粉钻时调起的社交平台，需要自行在模拟器上安装对应app",
            "cases": [
                {
                    "name": "QQ",
                    "label": "QQ (国服)",
                    "pipeline_override": {
                        "分享_点击分享": {
                            "next": [
                                "抽阁_分享QQ"
                            ]
                        }
                    }
                },
                {
                    "name": "WeChat",
                    "label": "微信 (国服)",
                    "pipeline_override": {
                        "分享_点击分享": {
                            "next": [
                                "抽阁_分享微信"
                            ]
                        }
                    }
                },
                {
                    "name": "Weibo",
                    "label": "微博 (国服)",
                    "pipeline_override": {
                        "分享_点击分享": {
                            "next": [
                                "抽阁_分享微博"
                            ]
                        }
                    }
                },
                {
                    "name": "Xiaohongshu",
                    "label": "小红书 (国服)",
                    "pipeline_override": {
                        "分享_点击分享": {
                            "next": [
                                "抽阁_分享小红书"
                            ]
                        }
                    }
                },
                {
                    "name": "LINE",
                    "label": "LINE (台服)",
                    "pipeline_override": {
                        "分享_点击分享": {
                            "next": [
                                "抽阁_分享LINE"
                            ]
                        }
                    }
                },
                {
                    "name": "Instagram",
                    "label": "Instagram (台服)",
                    "pipeline_override": {
                        "分享_点击分享": {
                            "next": [
                                "抽阁_分享Instagram"
                            ]
                        }
                    }
                }
            ],
            "default_case": "QQ"
        },
        "TaskPrivilegeOption": {
            "type": "switch",
            "label": "充值特权与耀星钻卡（测试中）",
            "description": "开启后在领取每日返钻时，额外检测并领取耀星钻卡奖励与充值特权每周礼包；本功能处于测试中，默认关闭",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "任务_每日返钻": {
                            "next": [
                                "[JumpBack]任务_钻石卡",
                                "[JumpBack]任务_特权卡",
                                "[JumpBack]任务_耀星钻卡",
                                "[JumpBack]任务_充值特权",
                                "任务_每日返钻返回"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "任务_每日返钻": {
                            "next": [
                                "[JumpBack]任务_钻石卡",
                                "[JumpBack]任务_特权卡",
                                "任务_每日返钻返回"
                            ]
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "YihaiJingyuOption": {
            "type": "switch",
            "label": "境遇挑战（测试中）",
            "description": "开启后在完成忆海心阶真我之境挑战后，额外自动进行心阶境遇关卡挑战；本功能处于测试中，默认关闭",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "忆海_战斗评分": {
                            "next": [
                                "忆海_境遇",
                                "忆海_结束"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "忆海_战斗评分": {
                            "next": [
                                "忆海_结束"
                            ]
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "FashionTaskOption": {
            "type": "switch",
            "label": "领取时尚任务",
            "description": "开启后在领取每日任务奖励后，自动切换至时尚任务页面并一键领取活跃度奖励；默认开启",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "任务_结束中继": {
                            "next": [
                                "[JumpBack]任务_领取时尚任务",
                                "任务_结束"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "任务_结束中继": {
                            "next": [
                                "任务_结束"
                            ]
                        }
                    }
                }
            ],
            "default_case": "Yes"
        }
    },
    "preset": [
        {
            "name": "默认配置",
            "label": "默认配置",
            "description": "自动勾选已就绪的日常任务（启动模拟器与游戏、送礼、组队本、抽卡、联盟任务、忆海心阶、美甲）",
            "task": [
                {
                    "name": "__MXU_PRETASK__启动模拟器与游戏",
                    "enabled": true
                },
                {
                    "name": "登陆游戏",
                    "enabled": true
                },
                {
                    "name": "送礼",
                    "enabled": true
                },
                {
                    "name": "组队本",
                    "enabled": true
                },
                {
                    "name": "竞技场",
                    "enabled": true
                },
                {
                    "name": "抽卡",
                    "enabled": true
                },
                {
                    "name": "联盟任务",
                    "enabled": true
                },
                {
                    "name": "忆海心阶",
                    "enabled": true
                },
                {
                    "name": "美甲",
                    "enabled": true
                },
                {
                    "name": "分享",
                    "enabled": true
                },
                {
                    "name": "评选赛",
                    "enabled": true
                },
                {
                    "name": "时空回廊",
                    "enabled": true
                },
                {
                    "name": "主线制衣",
                    "enabled": true
                },
                
                {
                    "name": "任务",
                    "enabled": true
                },
                {
                    "name": "退出模拟器",
                    "enabled": false
                }
            ]
        }
    ]
}
