{
    "projectName": "MaNikki4",
    "defaultTarget": "win-x86_64",
    "targets": [
        {
            "platform": "win",
            "arch": "x86_64"
        }
    ],
    "dependencies": {
        "maaFramework": {
            "repository": "MaaXYZ/MaaFramework",
            "release": "latest",
            "assetPattern": "MAA-{platform}-{arch}-*.zip"
        },
        "mxu": {
            "repository": "TianQuanDiWen/MXU_tqdw",
            "release": "latest",
            "assetPattern": "*{platform}-{arch}*"
        }
    },
    "toolchain": {
        "goVersion": "1.24.x",
        "pythonVersion": "3.13",
        "uvIndex": "https://pypi.org/simple"
    },
    "agent": {
        "source": "./agent/cmd/manikki-agent",
        "output": "agent/MaNikki4.Agent{exe}"
    },
    "directories": {
        "output": "install",
        "dependencies": "deps",
        "downloads": "downloads",
        "cache": "cache/downloads"
    },
    "packageName": "MaNikki4-{version}-{platform}-{arch}.zip"
}
